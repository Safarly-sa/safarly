# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Required for DB-backed routes (auth, sessions).
DATABASE_URL=postgres://safarly:safarly@localhost:5432/safarly

# Used by the AI agent routes (Live Lens, and any future itinerary/concierge
# agents). Get a free key at https://aistudio.google.com/apikey. Without this,
# agent routes fall back to demo mode automatically — see AGENTS_DEMO_MODE.
GEMINI_API_KEY=

# Controls whether agent routes call Gemini for real or return canned fixtures.
#   unset      -> demo mode unless GEMINI_API_KEY is set (the safe default)
#   true        -> always demo, even with a key configured (e.g. local frontend
#                  dev, so hot-reloading doesn't burn real quota)
#   false       -> always call Gemini for real; with no key this becomes a 503
#                  on every agent route rather than silently falling back
# AGENTS_DEMO_MODE=true

# Port the API listens on.
PORT=8080

# Comma-separated list of origins allowed to send credentialed (cookie-bearing)
# requests. In development any http://localhost:<port> is allowed automatically
# (see app.ts) — this only matters for staging/production origins.
# CORS_ORIGIN=https://safarly.pages.dev

# Only "production" changes behaviour (stricter cookies, quieter logs).
# Leave unset for local development — see CLAUDE.md's Gotchas section.
# NODE_ENV=production
