# Copy to .env.local to override. Never commit the real file.
# Vite only exposes vars prefixed VITE_ to client code — everything here is
# bundled into the JS and visible to anyone who opens devtools. Never put a
# secret in a VITE_ variable; secrets belong on the API server only
# (see artifacts/api-server/.env.example).

# Base URL of the API server. Defaults to http://localhost:8080 if unset — you
# only need this file for local dev if you're running the API on a different
# port, or routing through the Vite proxy (see vite.config.ts, VITE_USE_API_PROXY).
VITE_API_URL=http://localhost:8080
