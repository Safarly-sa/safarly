  { "id": "sh_barg_1", "dialect": "shamali","situation": "bargaining", "arabic": "غالي علي",                   "transliteration": "ghāli ʿalay",                  "english": "Too expensive for me" },
  { "id": "sh_barg_2", "dialect": "shamali","situation": "bargaining", "arabic": "ما في أرخص؟",               "transliteration": "mā fi arkhaṣ?",                "english": "Is there nothing cheaper?" },
  { "id": "sh_ticket_1","dialect": "shamali","situation": "tickets",   "arabic": "بكم الدخلة؟",               "transliteration": "bikam ad-dakhlah?",             "english": "How much is entry? (northern term)" },
  { "id": "sh_ticket_2","dialect": "shamali","situation": "tickets",   "arabic": "في خصم للشباب؟",             "transliteration": "fi khaṣm lish-shabāb?",        "english": "Is there a youth discount?" },
  { "id": "sh_ticket_3","dialect": "shamali","situation": "tickets",   "arabic": "متى الفتح؟",                 "transliteration": "mata l-fatḥ?",                 "english": "When does it open?" }
