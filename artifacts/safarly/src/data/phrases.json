  { "id": "h_barg_1",  "dialect": "hijazi","situation": "bargaining",  "arabic": "هذا غلاء",                   "transliteration": "haḏa ghalāʾ",                  "english": "This is expensive" },
  { "id": "h_barg_2",  "dialect": "hijazi","situation": "bargaining",  "arabic": "طيّب خلّيها",                "transliteration": "ṭayyib khalliha",              "english": "Okay, I'll take it" },
