  { "id": "j_dir_2",   "dialect": "janubi","situation": "directions",  "arabic": "في الوادي",                  "transliteration": "fi l-wādī",                    "english": "It's in the valley" },
  { "id": "j_dir_3",   "dialect": "janubi","situation": "directions",  "arabic": "على الشمال شوي",              "transliteration": "ala ash-shamāl shway",          "english": "A bit to the left / northward" },
  { "id": "j_barg_1",  "dialect": "janubi","situation": "bargaining",  "arabic": "ما يصير بكذا",               "transliteration": "mā yiṣīr bikaḏā",              "english": "It can't be at that price" },
  { "id": "j_barg_2",  "dialect": "janubi","situation": "bargaining",  "arabic": "رخّص عليّ شوي",              "transliteration": "rakhkhiṣ ʿalay shway",         "english": "Give me a small discount" },
  { "id": "j_ticket_1","dialect": "janubi","situation": "tickets",     "arabic": "بكم الدخول؟",                "transliteration": "bikam ad-dukhūl?",              "english": "How much is entry?" },
  { "id": "j_ticket_2","dialect": "janubi","situation": "tickets",     "arabic": "متى يفتحون؟",                "transliteration": "mata yiftaḥūn?",                "english": "When do they open?" },

  { "id": "sh_greet_1","dialect": "shamali","situation": "greeting",   "arabic": "مرحبا وهلا",                 "transliteration": "marḥabā wa-halā",              "english": "Welcome and hello!" },
  { "id": "sh_greet_2","dialect": "shamali","situation": "greeting",   "arabic": "كيفك يا أخي؟",               "transliteration": "kīfak yā akhī?",               "english": "How are you, brother?" },
  { "id": "sh_greet_3","dialect": "shamali","situation": "greeting",   "arabic": "الله يهنيك",                 "transliteration": "Allāh yihannik",               "english": "May God grant you ease" },
  { "id": "sh_order_1","dialect": "shamali","situation": "ordering",   "arabic": "شو عندكم اليوم؟",            "transliteration": "shū ʿandakum al-yōm?",         "english": "What do you have today?" },
  { "id": "sh_order_2","dialect": "shamali","situation": "ordering",   "arabic": "هاتوا لي...",                "transliteration": "hātū lī...",                   "english": "Bring me... (to a group)" },
  { "id": "sh_order_3","dialect": "shamali","situation": "ordering",   "arabic": "بلا بهارات زيادة",           "transliteration": "bilā bahārāt ziyāda",          "english": "Not too many spices, please" },
  { "id": "sh_taxi_1", "dialect": "shamali","situation": "taxi",       "arabic": "خذني إلى...",                "transliteration": "khuḏnī ilā...",                "english": "Take me to..." },
  { "id": "sh_taxi_2", "dialect": "shamali","situation": "taxi",       "arabic": "بكم الرحلة؟",                "transliteration": "bikam ar-riḥla?",              "english": "How much for the ride?" },
  { "id": "sh_taxi_3", "dialect": "shamali","situation": "taxi",       "arabic": "وقف هنا عند الإشارة",        "transliteration": "waqqif hina ʿind al-ishāra",   "english": "Stop here at the lights" },
  { "id": "sh_thanks_1","dialect": "shamali","situation": "thanks",    "arabic": "مشكورين",                    "transliteration": "mashkūrīn",                    "english": "Thank you all (northern plural)" },
  { "id": "sh_thanks_2","dialect": "shamali","situation": "thanks",    "arabic": "ما قصّرتوا",                 "transliteration": "mā qaṣṣartū",                  "english": "You've all done well (high praise)" },
  { "id": "sh_thanks_3","dialect": "shamali","situation": "thanks",    "arabic": "الله يعطيكم العافية",        "transliteration": "Allāh yaʿṭīkum al-ʿāfiya",    "english": "May God give you all good health" },
  { "id": "sh_dir_1",  "dialect": "shamali","situation": "directions", "arabic": "امشي على اليمين",            "transliteration": "imshi ala l-yamīn",            "english": "Go to the right" },
