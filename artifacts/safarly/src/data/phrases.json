  { "id": "h_thanks_1","dialect": "hijazi","situation": "thanks",      "arabic": "يسلمو",                      "transliteration": "yislamu",                      "english": "Thank you (Hijazi)" },
  { "id": "h_thanks_2","dialect": "hijazi","situation": "thanks",      "arabic": "الله يجزاك خير",             "transliteration": "Allāh yijzāk khair",           "english": "May God reward you well" },
  { "id": "h_thanks_3","dialect": "hijazi","situation": "thanks",      "arabic": "ما قصّرت",                   "transliteration": "mā qaṣṣart",                   "english": "You've done well (high praise)" },
  { "id": "h_dir_1",   "dialect": "hijazi","situation": "directions",  "arabic": "على طول",                    "transliteration": "ala ṭūl",                      "english": "Straight ahead" },
  { "id": "h_dir_2",   "dialect": "hijazi","situation": "directions",  "arabic": "دور يسار",                   "transliteration": "dawwir yasār",                 "english": "Turn left" },
  { "id": "h_dir_3",   "dialect": "hijazi","situation": "directions",  "arabic": "في الشارع الرئيسي",          "transliteration": "fi ash-shāriʿ ar-raʾīsi",      "english": "On the main street" },

  { "id": "j_greet_1", "dialect": "janubi","situation": "greeting",    "arabic": "يا مرحبا",                   "transliteration": "yā marḥabā",                   "english": "Hey there! (warm southern greeting)" },
