  { "id": "n_order_1", "dialect": "najdi", "situation": "ordering",    "arabic": "شو تبي؟",                    "transliteration": "shū tabī?",                    "english": "What would you like?" },
  { "id": "n_order_2", "dialect": "najdi", "situation": "ordering",    "arabic": "أجيب لك إيش؟",              "transliteration": "ajīb lak ēsh?",                "english": "What shall I bring you?" },
  { "id": "n_order_3", "dialect": "najdi", "situation": "ordering",    "arabic": "بدون بصل",                   "transliteration": "bidūn baṣal",                  "english": "Without onion, please" },
  { "id": "n_barg_1",  "dialect": "najdi", "situation": "bargaining",  "arabic": "رخّصلي",                     "transliteration": "rakhkhiṣ-li",                  "english": "Give me a discount" },
  { "id": "n_barg_2",  "dialect": "najdi", "situation": "bargaining",  "arabic": "هذا غالي بعد",               "transliteration": "haḏa ghāli baʿad",             "english": "This is still too expensive" },
  { "id": "n_barg_3",  "dialect": "najdi", "situation": "bargaining",  "arabic": "هذا آخر سعر؟",               "transliteration": "haḏa ākhir siʿr?",             "english": "Is this your final price?" },
  { "id": "n_thanks_1","dialect": "najdi", "situation": "thanks",      "arabic": "مشكور",                      "transliteration": "mashkūr",                      "english": "Thank you (Najdi)" },
  { "id": "n_thanks_2","dialect": "najdi", "situation": "thanks",      "arabic": "الله يعطيك العافية",         "transliteration": "Allāh yaʿṭīk al-ʿāfiya",      "english": "May God give you good health" },
  { "id": "n_thanks_3","dialect": "najdi", "situation": "thanks",      "arabic": "ما قصّرت",                   "transliteration": "mā qaṣṣart",                   "english": "You've done well (high praise)" },
  { "id": "n_dir_1",   "dialect": "najdi", "situation": "directions",  "arabic": "على طول",                    "transliteration": "ala ṭūl",                      "english": "Straight ahead" },
  { "id": "n_dir_2",   "dialect": "najdi", "situation": "directions",  "arabic": "وين الحمامات؟",              "transliteration": "wain al-ḥammāmāt?",            "english": "Where are the restrooms?" },
  { "id": "n_dir_3",   "dialect": "najdi", "situation": "directions",  "arabic": "بعيد؟",                      "transliteration": "baʿīd?",                       "english": "Is it far?" },

  { "id": "h_greet_1", "dialect": "hijazi","situation": "greeting",    "arabic": "أهلين",                      "transliteration": "ahlayn",                       "english": "Welcome! (warm Hijazi greeting)" },
  { "id": "h_greet_2", "dialect": "hijazi","situation": "greeting",    "arabic": "كيف حالك؟",                  "transliteration": "keef ḥālik?",                  "english": "How are you?" },
  { "id": "h_greet_3", "dialect": "hijazi","situation": "greeting",    "arabic": "الله يسعدك",                 "transliteration": "Allāh yisaʿdak",               "english": "May God make you happy" },
  { "id": "h_ticket_1","dialect": "hijazi","situation": "tickets",     "arabic": "بكام التذكرة؟",              "transliteration": "bikām at-tizkarah?",            "english": "How much is the ticket?" },
