[
  { "id": "n_greet_1", "dialect": "najdi", "situation": "greeting",    "arabic": "يا هلا",                     "transliteration": "yā halā",                      "english": "Welcome! / Hey there!" },
  { "id": "n_greet_2", "dialect": "najdi", "situation": "greeting",    "arabic": "كيف الأحوال؟",               "transliteration": "keef al-aḥwāl?",               "english": "How are things?" },
  { "id": "n_greet_3", "dialect": "najdi", "situation": "greeting",    "arabic": "هلا والله",                  "transliteration": "halā wallāh",                  "english": "Welcome, by God (warm greeting)" },
  { "id": "n_ticket_1","dialect": "najdi", "situation": "tickets",     "arabic": "بكم التذكرة؟",               "transliteration": "bikam at-tazkara?",             "english": "How much is the ticket?" },
  { "id": "n_ticket_2","dialect": "najdi", "situation": "tickets",     "arabic": "في تخفيض؟",                  "transliteration": "fī takhfīḍ?",                  "english": "Is there a discount?" },
  { "id": "n_ticket_3","dialect": "najdi", "situation": "tickets",     "arabic": "متى تبدأ؟",                  "transliteration": "mata tabda?",                  "english": "When does it start?" },
  { "id": "n_taxi_1",  "dialect": "najdi", "situation": "taxi",        "arabic": "وصّلني للمطار",              "transliteration": "waṣṣilni lil-maṭār",           "english": "Take me to the airport" },
  { "id": "n_taxi_2",  "dialect": "najdi", "situation": "taxi",        "arabic": "على الكيلومتر",              "transliteration": "ala al-kilometre",             "english": "By the meter, please" },
